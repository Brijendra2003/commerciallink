# ---------------------------------------------------------------------------
# CommercialLink — environment
#
# Copy to .env.local and fill in. With these blank the app still runs: it
# serves the typed mock data and logs form submissions instead of inserting
# them ("demo mode"), and the admin panel is unlocked.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API Keys → service_role.
# Server-side only. Never expose this to the browser, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute URL of this deployment. Used for password-reset redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Initial password given to every seeded staff account by `npm run db:seed`.
# At least 12 characters. Rotate it from the Supabase dashboard after seeding.
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Cloudinary — listing photographs and video walkthroughs.
#
# Uploads go from the browser straight to Cloudinary against a signature minted
# server-side, so the API secret never reaches the client. Without these the
# listing form reports that uploads are unavailable; the rest of the site runs.
# ---------------------------------------------------------------------------
CLOUDINARY_URL=
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# The cloud name is public — it appears in every delivery URL.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
